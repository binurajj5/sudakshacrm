generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  firstName        String
  lastName         String
  phone            String?
  avatar           String?
  role             Role           @default(USER)
  status           UserStatus     @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  activities       Activity[]     @relation("ActivityCreatedBy")
  auditLogs        AuditLog[]
  createdCompanies Company[]      @relation("CompanyCreatedBy")
  createdContacts  Contact[]      @relation("CreatedBy")
  createdCourses   Course[]       @relation("CourseCreatedBy")
  createdDeals     Deal[]         @relation("DealCreatedBy")
  refreshTokens    RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Contact {
  id          String        @id @default(uuid())
  type        ContactType
  status      ContactStatus @default(LEAD)
  firstName   String
  lastName    String
  email       String        @unique
  phone       String?
  companyId   String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  activities  Activity[]
  company     Company?      @relation(fields: [companyId], references: [id])
  createdBy   User          @relation("CreatedBy", fields: [createdById], references: [id])
  deals       Deal[]
  enrollments Enrollment[]

  @@map("contacts")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  type        CompanyType
  website     String?
  industry    String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  activities  Activity[]
  createdBy   User         @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  contacts    Contact[]
  deals       Deal[]
  enrollments Enrollment[]

  @@map("companies")
}

model Deal {
  id          String     @id @default(uuid())
  title       String
  amount      Float
  stage       DealStage  @default(PROSPECTING)
  contactId   String
  companyId   String?
  courseId    String? // Link deal to specific course solution
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  activities  Activity[]
  company     Company?   @relation(fields: [companyId], references: [id])
  contact     Contact    @relation(fields: [contactId], references: [id])
  course      Course?    @relation("CourseDeal", fields: [courseId], references: [id])
  createdBy   User       @relation("DealCreatedBy", fields: [createdById], references: [id])

  @@map("deals")
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  subject     String
  description String?
  scheduledAt DateTime?
  completed   Boolean      @default(false)
  completedAt DateTime?
  contactId   String?
  companyId   String?
  dealId      String?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  contact     Contact?     @relation(fields: [contactId], references: [id])
  company     Company?     @relation(fields: [companyId], references: [id])
  createdBy   User         @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  deal        Deal?        @relation(fields: [dealId], references: [id])

  @@map("activities")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  changes   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  SUPPORT
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContactType {
  STUDENT
  CORPORATE
  INSTITUTION
  INDIVIDUAL
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  INACTIVE
}

enum CompanyType {
  ENTERPRISE
  SMB
  STARTUP
  EDUCATION
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

// ============================================
// COURSE/PRODUCT MANAGEMENT MODELS (FR 3.0)
// ============================================

model Course {
  id               String         @id @default(uuid())
  name             String
  code             String         @unique // Course code (e.g., "WD-101", "DS-202")
  description      String?
  category         CourseCategory
  duration         Int? // Duration in hours
  level            CourseLevel    @default(BEGINNER)
  version          String         @default("1.0") // Version control (e.g., "1.0", "1.1", "2.0")
  status           CourseStatus   @default(DRAFT)
  isTemplate       Boolean        @default(false) // Is this a template for cloning?
  clonedFromId     String? // Reference to original course if this is a clone
  lmsIdentifier    String? // External LMS course ID (for future Learnyst integration)
  thumbnailUrl     String?
  syllabusPdfUrl   String?
  marketingContent String? // Rich text for marketing purposes
  price            Float? // Base price for B2C
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  clonedFrom       Course?        @relation("CourseClones", fields: [clonedFromId], references: [id])
  clones           Course[]       @relation("CourseClones")
  createdBy        User           @relation("CourseCreatedBy", fields: [createdById], references: [id])
  topics           CourseTopic[]
  deals            Deal[]         @relation("CourseDeal")
  enrollments      Enrollment[]

  @@map("courses")
}

model CourseTopic {
  id          String         @id @default(uuid())
  courseId    String
  title       String
  description String?
  orderIndex  Int // For maintaining topic order
  duration    Int? // Estimated duration in hours
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  modules     CourseModule[]

  @@unique([courseId, orderIndex])
  @@map("course_topics")
}

model CourseModule {
  id          String              @id @default(uuid())
  topicId     String
  title       String
  description String?
  orderIndex  Int // For maintaining module order within topic
  duration    Int? // Estimated duration in hours
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  topic       CourseTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lessons     CourseLesson[]
  assets      CourseLearningAsset[]

  @@unique([topicId, orderIndex])
  @@map("course_modules")
}

model CourseLesson {
  id             String              @id @default(uuid())
  moduleId       String
  title          String
  description    String?
  contentType    LessonContentType   @default(TEXT)
  contentUrl     String? // URL to video, document, or other content
  orderIndex     Int // For maintaining lesson order within module
  duration       Int? // Estimated duration in minutes
  isFree         Boolean             @default(false) // Is this a free preview lesson?
  lmsIdentifier  String? // External LMS lesson/content ID
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  module         CourseModule        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assets         CourseLearningAsset[]

  @@unique([moduleId, orderIndex])
  @@map("course_lessons")
}

model CourseLearningAsset {
  id            String          @id @default(uuid())
  type          AssetType
  title         String
  description   String?
  moduleId      String? // Can be attached to module
  lessonId      String? // Or to specific lesson
  lmsIdentifier String? // External LMS asset ID (quiz, project, assignment ID)
  assetUrl      String? // URL to downloadable resource
  dueOffset     Int? // Days after enrollment when assignment is due
  passingScore  Int? // Minimum passing score for quizzes (percentage)
  orderIndex    Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  lesson        CourseLesson?   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  module        CourseModule?   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("course_learning_assets")
}

model Enrollment {
  id                String           @id @default(uuid())
  courseId          String
  contactId         String
  companyId         String? // For B2B enrollments
  enrollmentType    EnrollmentType
  status            EnrollmentStatus @default(PENDING)
  enrollmentDate    DateTime?
  completionDate    DateTime?
  certificateUrl    String?
  lmsUserId         String? // Learnyst user ID after provisioning
  progressPercent   Int              @default(0)
  lastAccessedAt    DateTime?
  paymentStatus     PaymentStatus    @default(PENDING)
  amountPaid        Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company?         @relation(fields: [companyId], references: [id])
  contact           Contact          @relation(fields: [contactId], references: [id])
  course            Course           @relation(fields: [courseId], references: [id])
  paymentSchedule   PaymentSchedule[]

  @@map("enrollments")
}

model PaymentSchedule {
  id               String        @id @default(uuid())
  enrollmentId     String
  installmentNumber Int
  amount           Float
  dueDate          DateTime
  paidDate         DateTime?
  paymentMethod    String?
  transactionId    String?
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  enrollment       Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, installmentNumber])
  @@map("payment_schedules")
}

// ============================================
// ENUMS FOR COURSE MANAGEMENT
// ============================================

enum CourseCategory {
  TECHNICAL
  BUSINESS
  DESIGN
  MARKETING
  DATA_SCIENCE
  SOFT_SKILLS
  LANGUAGE
  CERTIFICATION
  OTHER
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum CourseStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DEPRECATED
}

enum LessonContentType {
  VIDEO
  TEXT
  PDF
  AUDIO
  INTERACTIVE
  EXTERNAL_LINK
}

enum AssetType {
  PROJECT
  QUIZ
  ASSIGNMENT
  RESOURCE
  READING
}

enum EnrollmentType {
  B2C_RETAIL
  B2B_CORPORATE
  B2B_INSTITUTIONAL
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  OVERDUE
  REFUNDED
}
