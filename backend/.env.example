# Application
APP_NAME=Sudaksha-CRM
APP_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/sudaksha_crm
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sudaksha_crm
DATABASE_USER=user
DATABASE_PASSWORD=password

# Authentication / Security
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# Feature Flags (future-safe, no logic yet)
ENABLE_AI_MODULE=false
ENABLE_MARKETING_MODULE=false
ENABLE_WHATSAPP_MODULE=false

# External Integrations (placeholders only – no implementation yet)
OPENAI_API_KEY=
WHATSAPP_CLOUD_API_TOKEN=
SENDGRID_API_KEY=
META_ADS_TOKEN=
GOOGLE_ADS_TOKEN=
LINKEDIN_ADS_TOKEN=